<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CSE489Lab" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/aqua</item>
        <item name="android:statusBarColor">@color/slate_dark</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="materialButtonStyle">@style/AppButton</item>
    </style>
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AppButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TitleLarge">
        <item name="android:textSize">29sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="SectionIntro">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="OverlineText">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textColor">@color/primary</item>
    </style>
</resources>
