<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/canvas" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/batteryToolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/slate_dark"
        app:title="System battery broadcast" android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp">
            <TextView style="@style/OverlineText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SYSTEM BROADCAST / BATTERY" />
            <TextView style="@style/TitleLarge" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="Battery monitor" />
            <TextView style="@style/SectionIntro" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="Reads the system ACTION_BATTERY_CHANGED broadcast and updates when the battery state changes." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="25dp" android:background="@drawable/bg_hero"
                android:orientation="vertical" android:padding="23dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="CURRENT BATTERY LEVEL" android:textColor="#D2D7FF"
                    android:letterSpacing="0.08" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/batteryPercentage" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="15dp"
                    android:text="--%" android:textColor="@color/white"
                    android:textSize="70sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/batteryProgress" style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="14dp"
                    android:layout_marginTop="8dp" android:max="100" android:progress="0"
                    android:progressTint="@color/aqua" android:progressBackgroundTint="#606994" />
                <TextView android:id="@+id/batteryCharging" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="Waiting for system event…" android:textColor="#E5E9FF" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="17dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="EVENT INFORMATION" android:letterSpacing="0.08"
                    android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/batteryHealth" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="13dp"
                    android:text="Battery state: --" android:textColor="@color/ink" android:textSize="14sp" />
                <TextView android:id="@+id/batterySource" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:text="Broadcast: android.intent.action.BATTERY_CHANGED"
                    android:textColor="@color/ink_secondary" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/batteryRefreshButton"
                    style="@style/AppButton.Outlined" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Refresh snapshot" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:text="Emulator tip: Use Extended Controls → Battery to change the level and charging state."
                android:textColor="@color/ink_secondary" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
