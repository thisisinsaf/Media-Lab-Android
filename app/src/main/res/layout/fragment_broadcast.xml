<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView style="@style/OverlineText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 / COMMUNICATION" />
        <TextView style="@style/TitleLarge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Broadcast receiver" />
        <TextView style="@style/SectionIntro" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Send a message with a custom Android broadcast or monitor live system battery updates." />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_hero"
            android:orientation="vertical" android:padding="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LIVE EVENT ROUTING" android:letterSpacing="0.15"
                android:textColor="#CACDFF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="One selection.\nTwo receiver flows."
                android:textColor="@color/white" android:textSize="23sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="Each option opens the correct activity for the selected broadcast type."
                android:textColor="#DAE0FF" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Select broadcast type" android:textColor="@color/ink"
                android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Choose one option to continue"
                android:textColor="@color/ink_secondary" android:textSize="13sp" />
            <Spinner android:id="@+id/broadcastSpinner" android:layout_width="match_parent"
                android:layout_height="56dp" android:layout_marginTop="15dp"
                android:contentDescription="Broadcast type" />
            <TextView android:id="@+id/broadcastOptionDescription"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:padding="14dp"
                android:background="@drawable/bg_rounded_soft" android:textColor="@color/ink_secondary"
                android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/broadcastContinueButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="Continue  →" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:layout_marginBottom="12dp"
            android:text="WHAT YOU'LL TEST" android:letterSpacing="0.08"
            android:textColor="@color/ink_secondary" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="18dp" android:background="@drawable/bg_card"
            android:text="01   Select a receiver mode\n\n02   Open the dedicated activity\n\n03   Observe the received broadcast"
            android:textColor="@color/ink" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
